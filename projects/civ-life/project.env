# Switchboard project binding for 'civ-life'. Sourced and exported by run-project.sh
# so the workspace hooks can see it. Secrets stay in the environment, not here.
SB_PROJECT_SLUG=civ-life
SB_WORKFLOW_STANCE=prototype
SB_GITHUB_REPO=colin-prologue/civ-life
SB_BASE_BRANCH=main
SB_WORKSPACE_ROOT=/Users/colindwan/Developer/switchboard-workspaces/civ-life
SB_CONVENTION_ROOT=
SB_VERIFY_CMD='./test.sh'
SB_VERIFY_TOOLS='"Bash(./test.sh)" "Bash(./capture.sh:*)"'
# Fold-signal detection (issue #51) and the review-response loop (issue #43 /
# AgDR-037) are allowlist-gated and short-circuit on an empty list. Committing
# these lines IS the deliberate per-project opt-in AgDR-037 asks for
# (issue #171 / AgDR-2026-08-29-login-config-is-a-project-binding).
SB_OPERATOR_LOGIN="colin-prologue"
SB_REVIEW_BOT="chatgpt-codex-connector"
# GITHUB_TOKEN is expected from the environment (GitHub App installation token).
