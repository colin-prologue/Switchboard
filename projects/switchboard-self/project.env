# Switchboard project binding for 'switchboard-self'. Sourced and exported by run-project.sh
# so the workspace hooks can see it. Secrets stay in the environment, not here.
SB_PROJECT_SLUG=switchboard-self
SB_GITHUB_REPO=colin-prologue/Switchboard
SB_BASE_BRANCH=main
SB_WORKSPACE_ROOT=/Users/colindwan/Developer/switchboard-workspaces/switchboard-self
SB_CONVENTION_ROOT=self/
# Fold-signal detection (issue #51) and the review-response loop (issue #43 /
# AgDR-037) are both allowlist-gated and both short-circuit on an empty list.
# Set here rather than in the shared template so the opt-in is per project and
# tracked; merging the change that added these lines IS the deliberate operator
# act AgDR-037 asks for (issue #171 / AgDR-049).
SB_OPERATOR_LOGIN="colin-prologue"
SB_REVIEW_BOT="chatgpt-codex-connector"
# GITHUB_TOKEN is expected from the environment (GitHub App installation token).
